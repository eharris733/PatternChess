/*
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Hashed build output and versioned engine/font files never change in place.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/stockfish/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
# Piece sets: a week, not immutable (file names aren't versioned).
/pieces/*
  Cache-Control: public, max-age=604800
# Versioned file names (-v1, -v2…): bump the suffix to change a video.
/video/*
  Cache-Control: public, max-age=31536000, immutable
# HTML (prerendered pages + SPA fallback) must always revalidate so deploys
# show up immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate
