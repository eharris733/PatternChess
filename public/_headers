/*
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Hashed build output and versioned engine/font files never change in place.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/stockfish/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
# HTML (prerendered pages + SPA fallback) must always revalidate so deploys
# show up immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate
# Unlisted creator-course demos (/c/<slug>) stay out of search.
/c/*
  X-Robots-Tag: noindex, nofollow
  # The course embeds the creator's YouTube video, which COEP require-corp
  # blocks outside Chrome's credentialless iframes. No engine runs here.
  ! Cross-Origin-Embedder-Policy
