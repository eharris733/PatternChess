{
  "name": "patternchess",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "blog:gen": "node scripts/build-blog.mjs",
    "learn:sync": "node scripts/build-learn.ts",
    "articles:sync": "node scripts/sync-articles.mjs",
    "build": "node scripts/build-blog.mjs && node scripts/fetch-landing-stats.mjs && tsc -b && vite build && node scripts/gen-seo.mjs && playwright install chromium-headless-shell && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:functions": "tsc -p functions --noEmit",
    "typecheck:notifier": "tsc -p workers/notifier --noEmit",
    "typecheck:social": "tsc -p scripts/social",
    "social:plan": "node scripts/social/plan.ts",
    "social:publish": "node scripts/social/publish.ts",
    "social:render": "node scripts/social/render.ts",
    "pages:dev": "npm run build && wrangler pages dev dist",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write src",
    "test": "vitest run",
    "e2e": "playwright test",
    "smoke": "playwright test tests/e2e/headers.spec.ts tests/e2e/engine.spec.ts",
    "ad:stats": "node marketing/ad/stats.ts",
    "ad:record": "node marketing/ad/record.ts",
    "ad:render": "node marketing/ad/stitch.ts",
    "forum:find": "node marketing/forum/run.ts",
    "migrate:export": "node scripts/migrate/export-supabase.mjs",
    "migrate:import": "node scripts/migrate/import-d1.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-query-persist-client": "^5.100.6",
    "better-auth": "1.7.18",
    "chess.js": "^1.4.0",
    "chessground": "^9.1.1",
    "clsx": "^2.1.1",
    "gifenc": "^1.0.3",
    "idb-keyval": "^6.2.1",
    "kysely": "0.28.19",
    "kysely-d1": "0.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^19.2.6",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.15.4",
    "stripe": "23.1.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@mliebelt/pgn-parser": "^1.4.19",
    "@napi-rs/canvas": "^1.2.0",
    "@playwright/test": "^1.48.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "25.6.0",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.20",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.2.0",
    "postcss": "^8.4.47",
    "stockfish": "18.0.5",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.158.0"
  }
}
